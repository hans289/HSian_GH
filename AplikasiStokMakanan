import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.util.ArrayList;
import java.util.List;
import java.util.Locale;

public class AplikasiStokMasakan extends JFrame {

    private static class BahanMasakan {
        String id;
        String nama;
        String kategori;
        String jumlah;
        String satuan;
        String kadaluarsa;

        BahanMasakan(String id, String nama, String kategori, String jumlah, String satuan, String kadaluarsa) {
            this.id = id;
            this.nama = nama;
            this.kategori = kategori;
            this.jumlah = jumlah;
            this.satuan = satuan;
            this.kadaluarsa = kadaluarsa;
        }
    }

    private final List<BahanMasakan> daftarBahan = new ArrayList<>();
    private final JTable tabelStok;
    private final DefaultTableModel modelTabel;
    private final JLabel labelStatus;
    private final JTextField txtCari;

    private String kategoriAktif = "Semua";
    private int counterSayuran = 0;
    private int counterBumbu = 0;
    private int counterDaging = 0;
    private int counterLainnya = 0;

    public AplikasiStokMasakan() {
        // 1. Pengaturan Dasar Jendela Utama
        setTitle("Aplikasi Manajemen Stok Masakan");
        setSize(880, 480);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        // Menggunakan BorderLayout dengan jarak antar komponen 5px
        setLayout(new BorderLayout(5, 5));

        // ==========================================
        // 2. BAGIAN NORTH (ATAS) - Header & Search
        // ==========================================
        JPanel panelNorth = new JPanel(new BorderLayout());
        panelNorth.setBackground(new Color(46, 204, 113));
        panelNorth.setBorder(BorderFactory.createEmptyBorder(10, 15, 10, 15));

        JLabel labelJudul = new JLabel("MANAJEMEN STOK MASAKAN DAPUR");
        labelJudul.setFont(new Font("SansSerif", Font.BOLD, 16));
        labelJudul.setForeground(Color.WHITE);

        JPanel panelSearch = new JPanel(new FlowLayout(FlowLayout.RIGHT, 5, 0));
        panelSearch.setOpaque(false);
        txtCari = new JTextField(15);
        JButton btnCari = new JButton("Cari");
        JLabel labelCari = new JLabel("Cari Bahan: ");
        labelCari.setForeground(Color.WHITE);

        panelSearch.add(labelCari);
        panelSearch.add(txtCari);
        panelSearch.add(btnCari);

        panelNorth.add(labelJudul, BorderLayout.WEST);
        panelNorth.add(panelSearch, BorderLayout.EAST);
        add(panelNorth, BorderLayout.NORTH);

        // ==========================================
        // 3. BAGIAN WEST (KIRI) - Panel Kategori
        // ==========================================
        JPanel panelWest = new JPanel();
        panelWest.setLayout(new BoxLayout(panelWest, BoxLayout.Y_AXIS));
        panelWest.setBorder(BorderFactory.createTitledBorder("Kategori"));
        panelWest.setPreferredSize(new Dimension(135, 0));

        String[] kategori = {"Semua", "Sayuran", "Bumbu", "Daging", "Lainnya"};
        for (String kat : kategori) {
            JButton btnKat = new JButton(kat);
            btnKat.setMaximumSize(new Dimension(120, 30));
            btnKat.setAlignmentX(Component.CENTER_ALIGNMENT);
            btnKat.addActionListener(e -> {
                kategoriAktif = kat;
                terapkanFilter();
            });
            panelWest.add(btnKat);
            panelWest.add(Box.createRigidArea(new Dimension(0, 8)));
        }
        add(panelWest, BorderLayout.WEST);

        // ==========================================
        // 4. BAGIAN CENTER (TENGAH) - Tabel Stok
        // ==========================================
        String[] kolom = {"ID", "Nama Bahan", "Kategori", "Jumlah", "Satuan", "Kadaluarsa"};
        modelTabel = new DefaultTableModel(kolom, 0) {
            @Override
            public boolean isCellEditable(int row, int column) {
                return false;
            }
        };

        tabelStok = new JTable(modelTabel);
        tabelStok.setRowHeight(25);
        JScrollPane scrollPane = new JScrollPane(tabelStok);
        add(scrollPane, BorderLayout.CENTER);

        // ==========================================
        // 5. BAGIAN EAST (KANAN) - Panel Tombol Aksi
        // ==========================================
        JPanel panelEast = new JPanel();
        panelEast.setLayout(new BoxLayout(panelEast, BoxLayout.Y_AXIS));
        panelEast.setBorder(BorderFactory.createTitledBorder("Aksi"));
        panelEast.setPreferredSize(new Dimension(140, 0));

        JButton btnTambah = new JButton("+ Tambah Data");
        JButton btnHapus = new JButton("Hapus Item");

        JButton[] tombolAksi = {btnTambah, btnHapus};
        for (JButton btn : tombolAksi) {
            btn.setMaximumSize(new Dimension(125, 35));
            btn.setAlignmentX(Component.CENTER_ALIGNMENT);
            panelEast.add(btn);
            panelEast.add(Box.createRigidArea(new Dimension(0, 10)));
        }
        add(panelEast, BorderLayout.EAST);

        // ==========================================
        // 6. BAGIAN SOUTH (BAWAH) - Status Bar
        // ==========================================
        JPanel panelSouth = new JPanel(new BorderLayout());
        panelSouth.setBorder(BorderFactory.createEtchedBorder());
        labelStatus = new JLabel(" Status: siap");
        labelStatus.setBorder(BorderFactory.createEmptyBorder(5, 10, 5, 10));
        panelSouth.add(labelStatus, BorderLayout.WEST);
        add(panelSouth, BorderLayout.SOUTH);

        // ==========================================
        // 7. DATA AWAL & LOGIKA TOMBOL
        // ==========================================
        muatDataAwal();
        terapkanFilter();

        // ActionListener Tombol Cari & Tekan Enter di kolom cari
        btnCari.addActionListener(e -> terapkanFilter());
        txtCari.addActionListener(e -> terapkanFilter());

        // ActionListener Tombol Tambah Data
        btnTambah.addActionListener(e -> tambahBahanBaru());

        // ActionListener Tombol Hapus Item
        btnHapus.addActionListener(e -> hapusBahanTerpilih());
    }

    private void muatDataAwal() {
        tambahKeDaftar("Tomat Merah", "Sayuran", "8", "buah", "2026-11-28");
        tambahKeDaftar("Bayam Segar", "Sayuran", "2", "ikat", "2026-11-27");
        tambahKeDaftar("Bawang Merah", "Bumbu", "500", "gram", "2026-12-10");
        tambahKeDaftar("Dada Ayam", "Daging", "1", "kg", "2026-11-26");
        tambahKeDaftar("Minyak Goreng", "Lainnya", "2", "liter", "2027-05-10");
    }

    private void tambahKeDaftar(String nama, String kategori, String jumlah, String satuan, String kadaluarsa) {
        String id = buatKodeKategori(kategori);
        daftarBahan.add(new BahanMasakan(id, nama, kategori, jumlah, satuan, kadaluarsa));
    }

    private String buatKodeKategori(String kategori) {
        switch (kategori) {
            case "Sayuran":
                counterSayuran++;
                return String.format("SYR-%03d", counterSayuran);
            case "Bumbu":
                counterBumbu++;
                return String.format("BMB-%03d", counterBumbu);
            case "Daging":
                counterDaging++;
                return String.format("DGG-%03d", counterDaging);
            default:
                counterLainnya++;
                return String.format("LNY-%03d", counterLainnya);
        }
    }

    private void tambahBahanBaru() {
        String[] pilihanKategori = {"Sayuran", "Bumbu", "Daging", "Lainnya"};
        JComboBox<String> comboKategori = new JComboBox<>(pilihanKategori);
        JTextField fieldNama = new JTextField();
        JTextField fieldJumlah = new JTextField();
        JTextField fieldSatuan = new JTextField("gram");
        JTextField fieldExp = new JTextField("2026-12-01");

        JPanel form = new JPanel(new GridLayout(0, 2, 8, 8));
        form.add(new JLabel("Kategori:"));
        form.add(comboKategori);
        form.add(new JLabel("Nama Bahan:"));
        form.add(fieldNama);
        form.add(new JLabel("Jumlah:"));
        form.add(fieldJumlah);
        form.add(new JLabel("Satuan:"));
        form.add(fieldSatuan);
        form.add(new JLabel("Kadaluarsa (YYYY-MM-DD):"));
        form.add(fieldExp);

        int hasil = JOptionPane.showConfirmDialog(
                this,
                form,
                "Tambah Bahan Masakan",
                JOptionPane.OK_CANCEL_OPTION,
                JOptionPane.PLAIN_MESSAGE
        );

        if (hasil == JOptionPane.OK_OPTION) {
            String kategoriDipilih = (String) comboKategori.getSelectedItem();
            String nama = fieldNama.getText().trim();
            String jumlah = fieldJumlah.getText().trim();
            String satuan = fieldSatuan.getText().trim();
            String exp = fieldExp.getText().trim();

            if (nama.isEmpty() || jumlah.isEmpty() || satuan.isEmpty() || exp.isEmpty()) {
                JOptionPane.showMessageDialog(this, "Semua kolom wajib diisi!");
                return;
            }

            tambahKeDaftar(nama, kategoriDipilih, jumlah, satuan, exp);
            kategoriAktif = kategoriDipilih;
            terapkanFilter();
        }
    }

    private void hapusBahanTerpilih() {
        int barisTerpilih = tabelStok.getSelectedRow();
        if (barisTerpilih == -1) {
            JOptionPane.showMessageDialog(this, "Pilih baris pada tabel yang ingin dihapus terlebih dahulu!");
            return;
        }

        String idTarget = modelTabel.getValueAt(barisTerpilih, 0).toString();
        daftarBahan.removeIf(item -> item.id.equals(idTarget));
        terapkanFilter();
    }

    private void terapkanFilter() {
        String kataKunci = txtCari.getText().trim().toLowerCase(Locale.ROOT);
        modelTabel.setRowCount(0);

        for (BahanMasakan item : daftarBahan) {
            boolean cocokKategori = kategoriAktif.equals("Semua") || item.kategori.equals(kategoriAktif);
            boolean cocokNama = kataKunci.isEmpty() || item.nama.toLowerCase(Locale.ROOT).contains(kataKunci);

            if (cocokKategori && cocokNama) {
                modelTabel.addRow(new Object[]{
                        item.id,
                        item.nama,
                        item.kategori,
                        item.jumlah,
                        item.satuan,
                        item.kadaluarsa
                });
            }
        }

        updateStatus(kataKunci);
    }

    private void updateStatus(String kataKunci) {
        int tampil = modelTabel.getRowCount();
        String infoPencarian = kataKunci.isEmpty() ? "" : " | Pencarian: \"" + kataKunci + "\"";
        labelStatus.setText(" Status: " + tampil + " bahan ditampilkan (Kategori: " + kategoriAktif + ")" + infoPencarian);
    }

    public static void main(String[] args) {
        try {
            UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName());
        } catch (Exception ignored) {
        }

        SwingUtilities.invokeLater(() -> new AplikasiStokMasakan().setVisible(true));
    }
}
